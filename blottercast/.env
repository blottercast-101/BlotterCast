# BlotterCast Environment Variables

# Google OAuth 2.0 Client ID (from Google Cloud Console)
# Example: 362507343436-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# Flask Secret Key
SECRET_KEY=dev-secret-change-me

# Brevo / Email MFA (optional for production email OTP)
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
